{
  "name": "vorn-extensions",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "ado",
    "airtable",
    "anthropic",
    "discord",
    "github",
    "gitlab",
    "hubspot",
    "jira",
    "kusto",
    "linear",
    "mysql",
    "notion",
    "ollama",
    "openai",
    "postgres",
    "rss",
    "slack",
    "stripe",
    "substack",
    "telegram",
    "trello",
    "x"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Apt run build",
    "conformance": "node scripts/check-conformance.mjs --write",
    "test": "yarn workspaces foreach -Ap run test",
    "typecheck": "yarn workspaces foreach -Ap run typecheck"
  }
}
